# Скопируйте этот файл в .env и заполните значения.
# Файл .env в git не попадает — он в .gitignore.

# --- Обязательное ---
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True

# --- Контакты (подставляются в шаблоны и в политику конфиденциальности) ---
SITE_OWNER=Глухов Антон Сергеевич
SITE_PHONE=+79954412021
SITE_PHONE_PRETTY=+7 (995) 441-20-21
SITE_EMAIL=glukhovas@yandex.ru
SITE_CITY=Красноярск
SITE_REGION=Красноярский край
SITE_TELEGRAM=
SITE_INN=382800965145
# Налоговый статус. Паспорт и СНИЛС на сайте не нужны — не добавляйте их сюда.
SITE_STATUS=самозанятый, налог на профессиональный доход

# --- Telegram ---
# Токен берётся у @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш личный chat_id — узнать можно у @userinfobot.
TELEGRAM_CHAT_ID=
# ID закрытого канала, обычно вида -1001234567890.
# Бот должен быть там администратором с правом приглашать по ссылке.
TELEGRAM_CLUB_CHAT_ID=

# --- Приём оплат (ЮKassa). Пока пусто — сайт работает в режиме заявок. ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Аналитика. Номер счётчика Яндекс.Метрики, только цифры. ---
YANDEX_METRIKA_ID=

# --- Прод ---
# Включите после первого успешного деплоя, когда сайт открылся.
SECURE_SSL_REDIRECT=False
# Включайте последним: браузеры запоминают HSTS надолго. Год = 31536000
SECURE_HSTS_SECONDS=0
