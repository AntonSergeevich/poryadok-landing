# Секрет вебхука автодеплоя.
# Лежит в /etc/s-poryadok/deploy-webhook.env, права 600, владелец root.
#
# Сознательно ОТДЕЛЬНЫЙ файл от .env проекта: слушатель работает от root,
# а сайт — нет, и сайту незачем видеть секрет, который даёт право
# выкатывать код на сервер.
#
# install_deploy_webhook.sh генерирует его сам. Руками:  openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Тот же секрет указывается в GitHub:
#   Settings -> Webhooks -> Add webhook
#     Payload URL:  https://s-poryadok.ru/internal/deploy-webhook
#     Content type: application/json
#     Secret:       <это же значение, без «DEPLOY_WEBHOOK_SECRET=»>
#     Events:       Just the push event

# Ветка, пуш в которую выкладывается сам.
#
# ВНИМАНИЕ: если сайт сейчас стоит на другой ветке, первый же пуш в эту
# выкатит её — со всем, что в ней есть и чего в ней нет. Сначала влейте
# рабочую ветку в main, потом включайте автодеплой.
DEPLOY_WEBHOOK_BRANCH=main
